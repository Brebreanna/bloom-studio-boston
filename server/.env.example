DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres
DATABASE_SSL=true

PORT=4000

# Email transport
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Sender identity
EMAIL_FROM_NAME=Bloom Studio Boston
EMAIL_FROM_ADDRESS=Contact@bloomstudioboston.com

SITE_URL=https://bloomstudioboston.com


# Square production payments
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
CORS_ORIGIN=https://bloomstudioboston.com

# Square production subscription plan variation IDs (created by npm run square:setup-memberships)
SQUARE_MEMBERSHIP_PETAL_MONTHLY_ID=
SQUARE_MEMBERSHIP_PETAL_ANNUAL_ID=
SQUARE_MEMBERSHIP_BLOOM_MONTHLY_ID=
SQUARE_MEMBERSHIP_BLOOM_ANNUAL_ID=
SQUARE_MEMBERSHIP_FULL_BLOOM_MONTHLY_ID=
SQUARE_MEMBERSHIP_FULL_BLOOM_ANNUAL_ID=

# Square webhook validation
SQUARE_WEBHOOK_URL=
SQUARE_WEBHOOK_SIGNATURE_KEY=
